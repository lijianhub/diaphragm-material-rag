# Copy this file to .env (git-ignored) and fill in the values you need.
# Never commit real keys. Variables already set in the environment take precedence.

# LLM provider keys (only the one you use is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default LLM for scripts/query.py and LLM rewriting in scripts/evaluate.py,
# e.g. openai:<model-id> or anthropic:<model-id>. Run scripts/check_llm.py to list OpenAI models.
RAG_LLM=
